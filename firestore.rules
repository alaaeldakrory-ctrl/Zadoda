
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // All family data lives under /families/{familyId}/.
    // Only the authenticated user whose UID matches the familyId may read or write.
    match /families/{familyId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == familyId;
    }

    // Deny everything else (old root-level collections, etc.)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
